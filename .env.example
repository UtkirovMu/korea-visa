# Nusxa oling:  cp .env.example .env.local   va qiymatlarni to'ldiring.

# MAJBURIY (production): kamida 32 belgili tasodifiy kalit. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISA_TOKEN_SECRET=

# Saytingiz manzili (Origin tekshiruvi va metadata uchun). Bir nechta bo'lsa vergul bilan.
SITE_URL=https://visa.turanschool.uz

# Sayt reverse-proxy (Vercel, Nginx, Cloudflare) ortida bo'lsa "true".
# To'g'ridan-to'g'ri internetga ochiq bo'lsa "false" (aks holda IP soxtalashtirilishi mumkin).
TRUST_PROXY=true

# Limitlar (ixtiyoriy)
# bitta IP: 10 daqiqada nechta tekshiruv
RATE_LIMIT_CHECK=5
# bitta IP: 1 daqiqada nechta holat so'rovi
RATE_LIMIT_STATUS=40
# butun sayt: soatiga nechta tekshiruv (visadoctors'ga ortiqcha yuk tushmasligi uchun)
GLOBAL_CHECKS_PER_HOUR=600

# Telegram'ga natija yuborish (ixtiyoriy). Bot (visabot) bilan BIR XIL token.
# Bot Web App URL'iga imzolangan chat ID qo'yadi; sayt imzoni shu token bilan tekshiradi
# va natijani o'sha chatga yuboradi. Berilmasa — bu funksiya o'chiq.
TELEGRAM_BOT_TOKEN=
